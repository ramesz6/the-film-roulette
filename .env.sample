SPRING_PROFILES_ACTIVE=dev

JWT_SECRET=
TMDB_API_KEY=

# Optional (Google login)
# Set the same Google OAuth Web client ID on both frontend and backend.
# VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id
# GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_web_client_id

# Database credentials (required)
POSTGRES_PASSWORD=

# Frontend (optional)
# VITE_API_BASE_URL=http://localhost:8080
# CORS_URLS can be left unset; the backend falls back to localhost dev origins.
# CORS_URLS=http://localhost:5173

# Optional overrides
# POSTGRES_USER=postgres
# POSTGRES_DB=postgres
# TMDB_API_BASE_URL=http://localhost:12345/
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=<your-password>