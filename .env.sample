SPRING_PROFILES_ACTIVE=dev

JWT_SECRET=
TMDB_API_KEY=

# Optional (Google login)
# Set the same Google OAuth Web client ID on both frontend and backend.
# VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id
# GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_web_client_id

# Render deployment notes
# - Render does NOT read this .env automatically. Add these as Environment Variables
#   in the Render Dashboard for each service.
#
# Backend (Spring Boot) required:
# SPRING_DATASOURCE_URL=jdbc:postgresql://<render-internal-db-host>:5432/<db>?sslmode=require
# SPRING_DATASOURCE_USERNAME=<db_user>
# SPRING_DATASOURCE_PASSWORD=<db_password>
# JWT_SECRET=<long_random>
# TMDB_API_KEY=<tmdb_key>
# GOOGLE_OAUTH_CLIENT_ID=<same_as_VITE_GOOGLE_CLIENT_ID>
# CORS_URLS=https://<your-frontend-onrender-domain>
#
# Frontend (Vercel/Render Static Site) build-time required:
# VITE_API_BASE_URL=https://<your-backend-onrender-domain>
# VITE_GOOGLE_CLIENT_ID=<google_oauth_web_client_id>

# Database credentials (required)
POSTGRES_PASSWORD=

# Frontend (optional)
# VITE_API_BASE_URL=http://localhost:8080
# CORS_URLS can be left unset; the backend falls back to localhost dev origins.
# CORS_URLS=http://localhost:5173

# Optional overrides
# POSTGRES_USER=postgres
# POSTGRES_DB=postgres
# TMDB_API_BASE_URL=http://localhost:12345/
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/postgres
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=<your-password>